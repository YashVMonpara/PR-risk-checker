# Copy to .env and fill in to enable GitHub OAuth login in the web app.
# Leave these blank to use the personal-access-token login instead (recommended for local use).

# Register an OAuth app at https://github.com/settings/developers
# Homepage URL:        http://localhost:3180
# Authorization callback URL: http://localhost:3180/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override the callback URL (use this if you serve behind a proxy).
# GITHUB_REDIRECT_URI=https://pr-risk-reviewer.example.com/api/auth/callback

# Session secret — change this in any non-local deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the web app listens on.
PORT=3180
