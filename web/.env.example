# Local environment for the PR Risk Checker web app.
# Copy this to web/.env and fill in the values below.

# --- GitHub OAuth (enables the "Sign in with GitHub" button) ---
# Register an OAuth app once at: https://github.com/settings/developers
#   Homepage URL:                 http://localhost:3180
#   Authorization callback URL:   http://localhost:3180/api/auth/callback
# Then paste the credentials here:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override the callback URL (use if serving behind a proxy/ngrok).
# GITHUB_REDIRECT_URI=https://your-host/api/auth/callback

# Session secret — change this in any non-local deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the web app listens on.
PORT=3180

# Bind address. Defaults to 127.0.0.1 (localhost only) — this server holds a
# live GitHub token and any LLM API key you type in, so it isn't reachable
# from other devices on your network unless you opt in here. Only uncomment
# this if you deliberately want LAN access, and set a real SESSION_SECRET
# above first.
# HOST=0.0.0.0
